# # ------------------------------------------------
# # Write build identity (name / version / checksum) for the app to
# # self-report on the checksum screen, same shape as the UDP packets it
# # receives from other apps (app_name / version / checksum).
# #
# # APP_VERSION is expected to be supplied at build time, e.g.:
# #   docker build --build-arg APP_VERSION=$(git describe --tags --always --dirty) ...
# #
# # The checksum is a sha256 over every file in the built bundle (sorted
# # for determinism), NOT the final Docker image digest — the image's own
# # digest can't be known until the image build finishes, so it can never
# # be embedded inside itself. This bundle checksum plays the same role
# # for this app as the other apps' reported checksums do for them.
# # ------------------------------------------------
# RUN set -eux; \
#     CHECKSUM=$(find /bundle -type f -print0 | sort -z | xargs -0 sha256sum | sha256sum | awk '{print $1}'); \
#     printf '{"app_name":"%s","version":"%s","checksum":"%s"}\n' \
#         "${APP_NAME}" "${APP_VERSION}" "${CHECKSUM}" > /bundle/build_info.json; \
#     cat /bundle/build_info.json

